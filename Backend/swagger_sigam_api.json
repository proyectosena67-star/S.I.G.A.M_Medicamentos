          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID de la aplicación",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "estado": {
                    "type": "string",
                    "example": "administrada"
                  },
                  "observacion": {
                    "type": "string",
                    "example": "Sin novedad"
                  }
                },
                "required": [
                  "estado"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
