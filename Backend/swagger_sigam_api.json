    "/aplicaciones/{id}/asignar": {
      "patch": {
        "summary": "Asignar la Dosis a un Enfermero",
        "tags": [
          "Aplicaciones"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID de la aplicación",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id_enfermero": {
                    "type": "integer",
                    "example": 3
                  }
                },
                "required": [
                  "id_enfermero"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dosis asignada correctamente"
          },
          "401": {
            "description": "No autorizado"
          }
        }
      }
    },
    "/aplicaciones/{id}/registrar": {
      "patch": {
        "summary": "Registrar Administración de Dosis",
        "tags": [
