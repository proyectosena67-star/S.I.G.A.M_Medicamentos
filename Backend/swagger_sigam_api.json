{
  "openapi": "3.0.3",
  "info": {
    "title": "S.I.G.A.M API",
    "version": "1.0.0",
    "description": "Documentación de la API de S.I.G.A.M generada a partir de la colección de Postman."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Servidor local de desarrollo"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Autenticación de Usuarios",
        "description": "Endpoint para iniciar sesión con credenciales de usuario (Administrador, Médico, Enfermero, Farmacéutico).",
        "tags": [
          "Autenticación"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "examples": {
                "Admin": {
                  "value": {
                    "correo": "admin@sigam.com",
                    "password": "Admin12345*"
                  }
                },
                "Medico": {
                  "value": {
                    "correo": "laura@sigam.com",
                    "password": "Medico12345*"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticación exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas"
          }
        }
      }
    },
    "/usuarios": {
      "post": {
        "summary": "Crear Usuario",
        "description": "Crea un nuevo usuario en el sistema (Médico, Enfermero, Enfermero Jefe, Farmacéutico, etc.).",
        "tags": [
          "Usuarios"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearUsuarioRequest"
              },
              "examples": {
                "CrearMedico": {
                  "summary": "Crear usuario médico",
                  "value": {
                    "id_rol": 2,
                    "tipo_documento": "CC",
                    "documento": "1012345678",
                    "nombres": "Laura",
                    "apellidos": "Gómez",
                    "correo": "laura@sigam.com",
                    "especialidad": "Medicina general"
                  }
                },
                "CrearEnfermero": {
                  "summary": "Crear usuario enfermero",
                  "value": {
                    "id_rol": 3,
                    "tipo_documento": "CC",
                    "documento": "1023456789",
                    "nombres": "Pedro",
                    "apellidos": "Martínez",
                    "correo": "pedro@sigam.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado exitosamente"
          },
          "400": {
            "description": "Datos de entrada inválidos"
          },
          "401": {
            "description": "No autorizado"
          }
        }
      }
    },
    "/usuarios/enfermeros": {
      "get": {
        "summary": "Listar Enfermeros Disponibles",
