  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "correo",
          "password"
        ],
        "properties": {
          "correo": {
            "type": "string",
            "format": "email",
            "example": "admin@sigam.com"
          },
          "password": {
            "type": "string",
            "example": "Admin12345*"
          }
        }
      },
      "CrearUsuarioRequest": {
        "type": "object",
        "required": [
          "id_rol",
          "tipo_documento",
          "documento",
          "nombres",
          "apellidos",
          "correo"
        ],
        "properties": {
          "id_rol": {
            "type": "integer",
            "example": 2
          },
          "tipo_documento": {
            "type": "string",
            "example": "CC"
          },
          "documento": {
            "type": "string",
            "example": "1012345678"
          },
          "nombres": {
            "type": "string",
            "example": "Laura"
          },
          "apellidos": {
            "type": "string",
            "example": "Gómez"
          },
          "correo": {
            "type": "string",
            "format": "email",
            "example": "laura@sigam.com"
          },
          "especialidad": {
            "type": "string",
            "example": "Medicina general"
          }
        }
      },
      "CrearPacienteRequest": {
        "type": "object",
        "required": [
          "tipo_documento",
          "documento",
          "nombres",
          "apellidos",
          "fecha_nacimiento",
          "genero"
        ],
        "properties": {
          "tipo_documento": {
            "type": "string",
            "example": "CC"
          },
          "documento": {
            "type": "string",
            "example": "1098765432"
          },
          "nombres": {
            "type": "string",
            "example": "Carlos"
          },
          "apellidos": {
            "type": "string",
            "example": "Ruiz"
          },
          "fecha_nacimiento": {
            "type": "string",
            "format": "date",
            "example": "1985-06-15"
          },
          "genero": {
            "type": "string",
            "example": "M"
          },
          "telefono": {
            "type": "string",
            "example": "3001234567"
          }
        }
      },
      "CrearMedicamentoRequest": {
        "type": "object",
        "required": [
          "codigo_cums",
          "nombre_generico",
          "nombre_comercial",
          "tipo_medicamento",
          "es_controlado",
          "stock_minimo"
        ],
        "properties": {
          "codigo_cums": {
            "type": "string",
            "example": "CUMS-001"
          },
          "nombre_generico": {
            "type": "string",
            "example": "Acetaminofén"
          },
          "nombre_comercial": {
            "type": "string",
            "example": "Dolex"
          },
          "tipo_medicamento": {
            "type": "string",
            "example": "Analgésico"
          },
          "es_controlado": {
            "type": "boolean",
            "example": false
          },
          "stock_minimo": {
            "type": "integer",
            "example": 20
          }
        }
      },
      "CrearLoteRequest": {
        "type": "object",
        "required": [
          "id_medicamento",
          "id_via",
          "id_presentacion",
          "num_lote",
          "fecha_vence",
          "stock_actual"
        ],
        "properties": {
          "id_medicamento": {
            "type": "integer",
            "example": 1
          },
          "id_via": {
            "type": "integer",
            "example": 1
          },
          "id_presentacion": {
            "type": "integer",
            "example": 1
          },
          "num_lote": {
            "type": "string",
            "example": "L-2026-01"
          },
          "fecha_vence": {
            "type": "string",
            "format": "date",
            "example": "2027-12-31"
          },
          "stock_actual": {
            "type": "integer",
            "example": 100
          }
        }
      },
      "CrearOrdenRequest": {
        "type": "object",
        "required": [
          "id_paciente",
          "detalles",
          "medicamentos"
        ],
        "properties": {
          "id_paciente": {
            "type": "integer",
            "example": 1
          },
          "detalles": {
            "type": "string",
            "example": "Control de dolor postoperatorio"
          },
          "medicamentos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id_medicamento": {
                  "type": "integer",
                  "example": 1
                },
                "id_via": {
                  "type": "integer",
                  "example": 1
                },
                "id_presentacion": {
                  "type": "integer",
                  "example": 1
                },
                "frecuencia_horas": {
                  "type": "integer",
                  "example": 8
                },
                "total_aplicaciones": {
                  "type": "integer",
                  "example": 6
                },
                "observaciones": {
                  "type": "string",
                  "example": "Con alimentos"
                }
              }
            }
          }
        }
      },
      "DispensacionRequest": {
        "type": "object",
        "required": [
          "id_detalle_orden",
          "id_lote",
          "cantidad_entregada"
        ],
        "properties": {
          "id_detalle_orden": {
            "type": "integer",
            "example": 2
          },
          "id_lote": {
            "type": "integer",
            "example": 1
          },
          "cantidad_entregada": {
            "type": "integer",
            "example": 6
          }
        }
      }
    }
  }
}